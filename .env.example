# Copy to .env.local. Never commit the real file.
COMPOSE_PROJECT_NAME=yuezhijian

# Local SQL Server only. Use a strong local value; production secrets come from the deployment platform.
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Local-Password_2026
DB_NAME=yuezhijian_dev
DB_USERNAME=yuezhijian_app
DB_PASSWORD=Replace-With-A-Different-App-Password_2026
DB_URL='jdbc:sqlserver://localhost:1433;databaseName=yuezhijian_dev;encrypt=true;trustServerCertificate=true'

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
SERVER_PORT=48080
ADMIN_UI_URL=http://localhost:5173
LOG_FILE=./.data/logs/yudao-server.log

MINIO_ROOT_USER=yuezhijian_local
MINIO_ROOT_PASSWORD=Replace-With-A-Strong-MinIO-Password_2026
MINIO_BUCKET=yuezhijian-dev
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=yuezhijian_local
MINIO_SECRET_KEY=Replace-With-A-Strong-MinIO-Password_2026
FILE_STORAGE_PROVIDER=minio
FILE_STORAGE_LOCAL_ROOT=.data/uploads
